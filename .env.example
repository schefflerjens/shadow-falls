# ==============================================================================
# Homer Creative Writing MCP Server Configuration Template
# Copy this file to '.env' in your project root or workspace and customize it:
#   cp .env.example .env
# ==============================================================================

# Required: OpenRouter API key for LLM calls (e.g. Claude, Gemini, GPT)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Note:
# The specific LLM model is configured on a per-project basis inside your
# book project under '[Agent Workspace]/Prompt Directives' document notes:
#
# ### Agent Metadata
# | Attribute | Value |
# | --- | --- |
# | Model | anthropic/claude-3.5-sonnet |
#

# Optional: Comma-separated list of additional project search roots to scan for book projects
# This allows the Homer Web Viewer/UI to search and load books across multiple directories.
# PROJECT_ROOTS=/Users/jensscheffler/projects/homer/books,/Users/jensscheffler/projects/shadow-falls
